# =============================================================================
# Caddy reference configuration for SealKeeper
# =============================================================================
# PRD: FR-H.43 — minimal example provided alongside the deploy bundle.
# Caddy auto-provisions a Let's Encrypt certificate for {$SK_DOMAIN}.
#
# Environment variables consumed (set by docker-compose.yml or your runner):
#   SK_DOMAIN     bare hostname, e.g. sealkeeper.example.com
#   SK_UPSTREAM   internal Compose address of SealKeeper (defaults sealkeeper-backend:8443,
#                 the backend-network alias declared in docker-compose.yml)
#   ACME_EMAIL    contact email for Let's Encrypt account (optional but
#                 recommended — used for expiry notifications)
# =============================================================================

{
	# Email used for Let's Encrypt account registration. Leave empty to use
	# Caddy's internal account (anonymous). FR-H.43 recommends a real address.
	email {$ACME_EMAIL}

	# Modern TLS only — matches FR-H.76 (TLS 1.2+ enforced at the proxy).
	servers {
		protocols h1 h2 h3
	}
}

{$SK_DOMAIN} {
	# Reverse proxy to SealKeeper. SealKeeper terminates plain HTTP on :8443
	# and trusts X-Forwarded-* only when the source is in
	# SK_TRUSTED_PROXY_CIDRS (FR-H.42, D-H.22). In the bundled Compose stack
	# that is Caddy's pinned backend address 172.31.250.10/32, reached via the
	# backend-only alias `sealkeeper-backend` (SK-35).
	reverse_proxy {$SK_UPSTREAM:sealkeeper-backend:8443} {
		# Caddy is the edge: overwrite (never append to) any client-supplied
		# X-Forwarded-For so the first hop SealKeeper sees is the real peer.
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto https
		# Health check from Caddy to SealKeeper (separate from container probe)
		health_uri /healthz
		health_interval 30s
		health_timeout 5s
	}

	# Compression — module H §3.3
	encode gzip zstd

	# Static assets (SK-36). The generation bundle is served from the fixed,
	# un-hashed URL /static/sealkeeper-generation.umd.js without SRI, and it is
	# the code that generates every password. It must therefore NEVER be
	# cached as immutable: `no-cache` lets browsers keep a copy but forces a
	# conditional revalidation on each use, so a generator fix reaches every
	# client on the next page load. /static/branding/* keeps the server's own
	# short max-age. `defer` applies the value after the upstream response.
	@static {
		path /static/*
		not path /static/branding/*
	}
	header @static {
		Cache-Control "no-cache"
		defer
	}

	# Security headers. SealKeeper sets Content-Security-Policy,
	# Strict-Transport-Security, X-Frame-Options, Referrer-Policy and
	# X-Content-Type-Options itself — Caddy passes them through unchanged
	# rather than sending duplicate or conflicting values (module E).
	header {
		# Permissions-Policy: disable powerful APIs the app does not use.
		# `?` only sets it when the upstream response has none.
		?Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
		# Caddy adds Server: Caddy by default; hide it to reduce reconnaissance.
		-Server
	}

	# Structured access log — JSON, one line per request.
	log {
		output file /var/log/caddy/sealkeeper-access.log {
			roll_size     50mb
			roll_keep     5
			roll_keep_for 14d
		}
		format json
	}
}
